<Window x:Class="bt_tet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BTVN_23207010" Height="850" Width="1560" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Window.Resources>

        <Color x:Key="PrimaryColor">#6C5CE7</Color>
        <Color x:Key="PrimaryAccent">#A29BFE</Color>
        <Color x:Key="SurfaceLight">#F7FBFF</Color>
        <Color x:Key="Surface">#FFFFFF</Color>
        <Color x:Key="BorderDark">#2D3436</Color>
        <Color x:Key="MutedText">#6C757D</Color>
        <Color x:Key="KMapCellBgColor">#FFFFFF</Color>
        <Color x:Key="KMapDontCareBg">#FFEAE0</Color>


        <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A2A1F0" Offset="0"/>
            <GradientStop Color="#5F5FAD" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccent}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
       
        <SolidColorBrush x:Key="PanelTextBrush" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="KMapCellBgBrush" Color="{StaticResource KMapCellBgColor}"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedText}"/>
        <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDark}"/>
        <SolidColorBrush x:Key="KMapDontCareBrush" Color="{StaticResource KMapDontCareBg}"/>


        <SolidColorBrush x:Key="Group0Brush" Color="#FFC62828"/>
        <SolidColorBrush x:Key="Group1Brush" Color="#FF1565C0"/>
        <SolidColorBrush x:Key="Group2Brush" Color="#FF00897B"/>
        <SolidColorBrush x:Key="Group3Brush" Color="#FFEF6C00"/>
        <SolidColorBrush x:Key="Group4Brush" Color="#FF6A1B9A"/>
        <SolidColorBrush x:Key="Group5Brush" Color="#FF6F1E8A"/>
        <SolidColorBrush x:Key="Group6Brush" Color="#FF00796B"/>

        <DropShadowEffect x:Key="PanelShadow" Color="#000000" Opacity="0.12" BlurRadius="16" ShadowDepth="4"/>
        <DropShadowEffect x:Key="CellShadow" Color="#000000" Opacity="0.06" BlurRadius="6" ShadowDepth="2"/>

        <Style TargetType="Button" x:Key="RoundedButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,4"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="RoundedComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#E6EEF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="TextBox" x:Key="RoundedTextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#E6EEF9"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="KMapOuterBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource PanelGradient}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource PanelTextBrush}"/>
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>

        <Style x:Key="KMapCellBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#D6DEE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{StaticResource KMapCellBgBrush}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect" Value="{StaticResource CellShadow}"/>
        </Style>

        <Style x:Key="KMapHeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="KMapCellValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BorderDarkBrush}"/>
        </Style>

        <Style x:Key="SmallHeaderRect" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        </Style>

        <DropShadowEffect x:Key="GroupHighlightShadow" Color="#000000" Opacity="0.12" BlurRadius="10" ShadowDepth="0"/>


    </Window.Resources>

    <Grid Margin="10">
        <TabControl Background="#F3F2FF">
            <TabItem Header=" Karnaugh " FontSize="14" Padding="15,5">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelGradient}" CornerRadius="14" Padding="20" Margin="0,0,12,0" BorderBrush="#DCEFFD" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="INPUT" FontSize="36" Style="{StaticResource KMapHeaderText}" Margin="0,0,0,12" HorizontalAlignment="Center"/>

                            <TextBlock Text="Số biến" FontWeight="SemiBold" Foreground="Black"/>
                            <ComboBox Name="cbVarsK" Margin="0,6,0,12" SelectedIndex="0" Style="{StaticResource RoundedComboBox}">
                                <ComboBoxItem Content="2 Biến"/>
                                <ComboBoxItem Content="3 Biến"/>
                                <ComboBoxItem Content="4 Biến"/>
                                <ComboBoxItem Content="5 Biến"/>
                            </ComboBox>

                            <TextBlock Text="Minterms" FontWeight="SemiBold" Foreground="Black"/>
                            <TextBox Name="txtMintermsK" Margin="0,6,0,10" Height="34.62" TextWrapping="Wrap" Style="{StaticResource RoundedTextBox}"/>

                            <TextBlock Text="Don't Care (d)" FontWeight="SemiBold" Foreground="Black"/>
                            <TextBox Name="txtDontCareK" Margin="0,6,0,12" Height="34.62" TextWrapping="Wrap" Style="{StaticResource RoundedTextBox}"/>

                            <GroupBox Header="" Padding="8" Margin="0,0,0,12" Background="#00FFFFFF" BorderBrush="#E8F0FB" Foreground="{StaticResource MutedTextBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Name="rbSOP" Content="SOP" IsChecked="True" Margin="0,0,24,0"/>
                                    <RadioButton Name="rbPOS" Content="POS"/>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="GIẢI" Click="BtnSolveK_Click" Height="57" Style="{StaticResource RoundedButton}" Foreground="Black" FontSize="36" RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform Y="30"/>
                                    </TransformGroup>
                                </Button.RenderTransform>
                            </Button>

                            <TextBlock Text="Kết quả" FontWeight="SemiBold" Margin="0,16,0,6" Foreground="Black" HorizontalAlignment="Center" FontSize="18" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform Y="30"/>
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBox Name="txtSimplifiedK" Padding="10" IsReadOnly="True" Height="110" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" Foreground="#007BFF" BorderBrush="#E6F0FF" BorderThickness="2" Background="{StaticResource SurfaceBrush}" RenderTransformOrigin="0.5,0.5">
                                <TextBox.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform Y="30"/>
                                    </TransformGroup>
                                </TextBox.RenderTransform>
                            </TextBox>

                            <TextBlock Name="txtStatus" Foreground="Red" FontWeight="Bold" Margin="0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform Y="50"/>
                                    </TransformGroup>
                                </StackPanel.RenderTransform>
                                <TextBlock Text="Màu nhóm:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="Black"/>
                                <Rectangle x:Name="rectGroup0" Width="18" Height="18" Fill="{StaticResource Group0Brush}" RadiusX="4" RadiusY="4" Margin="2"/>
                                <Rectangle x:Name="rectGroup1" Width="18" Height="18" Fill="{StaticResource Group1Brush}" RadiusX="4" RadiusY="4" Margin="2"/>
                                <Rectangle x:Name="rectGroup2" Width="18" Height="18" Fill="{StaticResource Group2Brush}" RadiusX="4" RadiusY="4" Margin="2"/>
                                <Rectangle x:Name="rectGroup3" Width="18" Height="18" Fill="{StaticResource Group3Brush}" RadiusX="4" RadiusY="4" Margin="2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderThickness="0" Padding="12">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Name="kMapHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header=" Quine McCluskey " FontSize="14" Padding="15,5">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelGradient}" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#EAF5FF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="INPUT" FontSize="36" FontWeight="Bold" Style="{StaticResource KMapHeaderText}"  Margin="0,0,0,12" HorizontalAlignment="Center"/>
                            <TextBlock Text="Số biến:"/>
                            <TextBox Name="txtVarsQ" Text="" Margin="0,6,0,12" Style="{StaticResource RoundedTextBox}" Height="34.62"/>
                            <TextBlock Text="Minterms:"/>
                            <TextBox Name="txtMintermsQ" Margin="0,6,0,12" Height="34.62" TextWrapping="Wrap" Style="{StaticResource RoundedTextBox}"/>
                            <TextBlock Text="Don't Care:"/>
                            <TextBox Name="txtDontCareQ" Margin="0,6,0,12" Height="34.62" TextWrapping="Wrap" Style="{StaticResource RoundedTextBox}"/>
                            <Button Content="GIẢI" Click="BtnSolveQuine_Click" Height="57" Style="{StaticResource RoundedButton}"  Foreground="Black" FontSize="36" RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform Y="99.5"/>
                                    </TransformGroup>
                                </Button.RenderTransform>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14">
                        <ScrollViewer>
                            <TextBlock Name="txtQuineResult" FontSize="14" Foreground="#0B2944" Text="Chờ..."/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
